# Copie para .env e preencha com valores reais.
# NUNCA commite o arquivo .env — apenas este .env.example.

# Kafka (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_TOPIC=consentimentos
KAFKA_API_KEY=
KAFKA_API_SECRET=

# MongoDB Atlas ("base Susep" simulada)
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
MONGO_DB_NAME=susep_simulado

# API (FastAPI)
JWT_SECRET=troque-por-um-valor-aleatorio-com-32-bytes-ou-mais
JWT_EXPIRE_MINUTES=30
DEMO_API_USERNAME=demo
DEMO_API_PASSWORD=troque-por-uma-senha-forte

# Dashboard (Streamlit)
API_BASE_URL=http://localhost:8000

# Pipeline / demo
STREAM_TRIGGER_INTERVAL=1 minute
DEMO_EVENT_COUNT=500
DEMO_CLIENT_COUNT=100
